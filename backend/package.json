{
  "name": "excalibur-backend",
  "version": "2.0.0",
  "private": true,
  "description": "Excalibur game key store — Fastify + PostgreSQL REST API (SE327 re-engineering of the SE262 project)",
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "db:reset": "node scripts/db-reset.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "lint": "eslint ."
  },
  "engines": {
    "node": ">=20.12"
  },
  "dependencies": {
    "@fastify/multipart": "^9.4.0",
    "@fastify/secure-session": "^8.4.1",
    "@fastify/static": "^8.3.0",
    "bcryptjs": "^3.0.3",
    "fastify": "^5.12.5",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@vitest/coverage-v8": "^3.2.7",
    "eslint": "^9.39.5",
    "globals": "^16.5.0",
    "vitest": "^3.2.7"
  }
}
